# Supabase
SUPABASE_URL=https://jawfalghkftldvkopuaw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Encryption key for storing plugin credentials (32-byte hex, generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CREDENTIALS_ENCRYPTION_KEY=

# App URL (used for OAuth redirect_uri)
APP_URL=http://localhost:3000
SERVER_PORT=4000

# Worker's public URL (server pings this to enqueue new tasks)
WORKER_URL=http://localhost:4100

# ── Per-plugin OAuth apps — create these in each provider's developer console ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
