# Supabase
SUPABASE_URL=https://cugaysbdpfzunwwlbfsn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Encryption key for storing plugin credentials (32-byte hex, generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CREDENTIALS_ENCRYPTION_KEY=

# Public frontend URL and public control-plane URL. OAuth providers must use
# API_PUBLIC_URL/api/plugins/callback as the registered redirect URI.
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT=180
SERVER_PORT=4000

# OpenRouter powers fast chat and the dedicated precision summarizer.
OPENROUTER_API_KEY=
FAST_CHAT_MODEL=google/gemini-2.5-flash-lite
SUMMARY_MODEL=google/gemini-2.5-flash-lite
SUMMARY_FALLBACK_MODEL=google/gemini-2.5-flash
MEMORY_MODEL=google/gemini-2.5-flash-lite

# Worker's public URL (server pings this to enqueue new tasks)
WORKER_URL=http://localhost:4100

# Shared secret expected in X-Agentie-Webhook-Secret for connector events.
CONNECTOR_WEBHOOK_SECRET=

# ── Per-plugin OAuth apps — create these in each provider's developer console ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
